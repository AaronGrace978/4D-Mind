{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "4D Mind",
  "version": "1.1.0",
  "identifier": "com.aarongrace.fourdmind",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "4D Mind",
        "url": "index.html",
        "width": 1480,
        "height": 960,
        "minWidth": 960,
        "minHeight": 680,
        "backgroundColor": "#07080b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
